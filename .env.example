# ── Database (DigitalOcean Managed Postgres) ──────────────────────────────
# Pooled connection (PgBouncer, transaction mode). App and worker use this.
DATABASE_URL=
# Direct connection. Migrations and session-scoped SQL only — never the app.
# Migrations fail or hang against the pooled port.
DATABASE_URL_DIRECT=

# ── Queue / cache (DigitalOcean Managed Valkey) ───────────────────────────
# BullMQ connection for ingestion, scoring, and brief generation jobs.
REDIS_URL=

# ── Data sources ──────────────────────────────────────────────────────────
SAM_GOV_API_KEY=
# Legacy alias still read by lib/ingestion/sam-gov/fetch.ts
SAM_API_KEY=

# ── LLM (capture brief generation only; never used in scoring) ────────────
ANTHROPIC_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
BRIEFING_FROM_EMAIL="War Room <briefing@warroomusa.com>"
# Comma-separated allowlist. When set, briefings send only to these addresses —
# the safety catch for the §12 manual-briefing phase and for staging.
BRIEFING_ALLOWLIST=

# ── Billing (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Single tier at launch: $149/month, 14 day trial (product spec §9).
STRIPE_PRICE_ID_CAPTURE=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
JWT_SECRET=
# Bearer token guarding the internal admin/ops routes.
SAM_SYNC_TOKEN=
